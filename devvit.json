{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mtgcardbelcher-dev",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true,
    "redis": true,
    "http": {
      "enable": true,
      "domains": [
        "api.scryfall.com"
      ]
    }
  },
  "dev": {
    "subreddit": "mtgcardbelcher_de_dev"
  }
}